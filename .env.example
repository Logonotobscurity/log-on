# Copy to .env (git-ignored) and fill in. Placeholders only - nothing here is a real secret.
POSTGRES_USER=logon
POSTGRES_DB=logon
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Approval UI sign-in: generate with  docker compose run --rm --entrypoint python app -m log_on.approval_ui --gen-token ada
LOG_ON_APPROVER_TOKENS=ada:replace-with-a-generated-token
LOG_ON_TRUSTED_DOMAINS=acme.example
# Per-user daily budgets (0 or empty = unlimited)
LOG_ON_USER_DAILY_RUNS=200
LOG_ON_USER_DAILY_TOKENS=500000
LOG_ON_USER_DAILY_COST_USD=2
LOG_ON_USER_BUDGETS=
LOG_ON_QUOTA_TZ=Africa/Lagos
# Planner model. Empty = the default: Groq openai/gpt-oss-120b when GROQ_API_KEY is set, otherwise the rule planner
# (also the automatic fallback on any model error). none = rules everywhere. llamacpp = docker compose --profile llm
# (then also LOG_ON_LLM_BASE_URL=http://llamacpp:8080/v1). Free Groq tier: 30 req/min, 1K req/day.
LOG_ON_LLM_PROVIDER=
# LOG_ON_LLM_BASE_URL=
# LOG_ON_LLM_API_KEY=
# Hosted presets (groq, groq-qwen, openrouter, openrouter-free) read their own key only:
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Build options
WITH_ML=0
GIT_SHA=
